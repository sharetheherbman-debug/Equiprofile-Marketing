# ==============================================================================
# EQUIPROFILE PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in actual values. Never commit .env.
# Infrastructure credentials are VPS-environment only and are not editable in
# the EquiProfile dashboard.
# ==============================================================================

# Core application
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
BASE_URL=https://equiprofile.online

# Database
DATABASE_URL=mysql://equiprofile:password@localhost:3306/equiprofile

# Authentication and security
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_UNLOCK_PASSWORD=replace-with-a-strong-admin-unlock-password
PRIMARY_ADMIN_EMAIL=
# Comma-separated origins allowed to make cookie-authenticated state changes.
# Leave empty to trust BASE_URL plus its www variant only.
EQUIPROFILE_TRUSTED_ORIGINS=https://equiprofile.online,https://www.equiprofile.online

# Feature flags
ENABLE_STRIPE=false
ENABLE_UPLOADS=false
ENABLE_PWA=true
VITE_PWA_ENABLED=true

# OAuth (optional)
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# Stripe — server-side only
# ENABLE_STRIPE=true
# STRIPE_SECRET_KEY=sk_live_xxxxx
# STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# STRIPE_MONTHLY_PRICE_ID=price_xxxxx
# STRIPE_YEARLY_PRICE_ID=price_xxxxx
# STRIPE_STABLE_MONTHLY_PRICE_ID=price_xxxxx
# STRIPE_STABLE_YEARLY_PRICE_ID=price_xxxxx

# Storage
# STORAGE_PROXY_URL=https://your-storage-proxy.com
# STORAGE_PROXY_KEY=your_storage_proxy_key
# STORAGE_PATH=/app/uploads
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=eu-west-2
# AWS_S3_BUCKET=equiprofile-uploads

# EquiProfile core AI helper — GenX only, server-side only
# Normal setup is key-only. No Qwen, Hugging Face, Together or DeepInfra fallback
# is permitted on this branch.
GENX_API_KEY=replace-with-your-equiprofile-genx-key
GENX_MODEL=gpt-5.4-turbo
GENX_BASE_URL=https://query.genx.sh/v1

# EquiProfile -> standalone Marketing connector
# Use the exact same EQUIPROFILE_CONNECTOR_KEY in the Marketing VPS environment.
# Generate it once with: openssl rand -base64 48
MARKETING_APP_URL=https://marketing.equiprofile.online
MARKETING_API_URL=https://marketing.equiprofile.online/api/v1
EQUIPROFILE_APP_ID=equiprofile
EQUIPROFILE_CONNECTOR_KEY=replace-with-the-shared-64-character-equiprofile-connector-key

# Maps (optional)
# VITE_MAPS_PROXY_URL=https://your-maps-proxy.com
# VITE_MAPS_API_KEY=your_maps_key

# SMTP — server-side only
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@equiprofile.online
CONTACT_TO=support@equiprofile.online

# WhatsApp/Twilio — server-side only
ENABLE_WHATSAPP=false
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Security and reverse proxy
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
# COOKIE_DOMAIN=.equiprofile.online
# COOKIE_SECURE=true

# Logging
LOG_LEVEL=info
# LOG_FILE_PATH=/var/log/equiprofile/app.log

# Build information
# BUILD_ID=abc123
# BUILD_TIME=2026-01-07T12:00:00.000Z

# Sales chat administration
# ADMIN_LEADS_KEY=replace-with-a-long-random-secret

# Frontend selection
# v2 = redesigned EquiProfile relaunch frontend (production target)
# v1 = legacy rollback frontend only
VITE_UI_VERSION=v2
